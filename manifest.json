{
  "manifest_version": 3,
  "name": "x-小说拓展",
  "short_name": "x小说",
  "version": "1.1.7",
  "description": "自动识别小说网页，进入无广告、无推荐、无干扰的纯净阅读模式，并自动拼接被拆成多页的章节。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "x-小说拓展",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "content/core.js",
        "content/site-rules.js",
        "content/extract.js",
        "content/merge.js",
        "content/detect.js",
        "content/reader-style.js",
        "content/reader.js",
        "content/purify.js",
        "content/boot.js"
      ],
      "css": ["content/page.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "进入或退出纯净阅读模式"
    }
  }
}
